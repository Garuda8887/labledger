{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labledger.local/schemas/extractor-row.json",
  "title": "ExtractorRow",
  "description": "Candidate row from rule-based parser or Extractor plugin. All plugin output must pass normalization and review.",
  "type": "object",
  "required": [
    "raw_test_name",
    "raw_value"
  ],
  "additionalProperties": false,
  "properties": {
    "raw_test_name": {
      "type": "string",
      "minLength": 1
    },
    "raw_value": {
      "type": "string",
      "minLength": 1
    },
    "raw_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_ref_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparator": {
      "type": "string",
      "enum": [
        "=",
        "<",
        ">",
        "<=",
        ">="
      ],
      "default": "="
    },
    "value_numeric": {
      "type": [
        "number",
        "null"
      ]
    },
    "value_qualitative": {
      "type": [
        "string",
        "null"
      ]
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "bbox": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "properties": {
        "x0": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "page_width": {
          "type": [
            "number",
            "null"
          ]
        },
        "page_height": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "confidence_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source": {
      "type": "string",
      "enum": [
        "rule",
        "ocr",
        "plugin"
      ],
      "default": "rule"
    }
  }
}
